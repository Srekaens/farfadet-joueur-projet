@startuml MCD

' Style
skinparam class {
    BackgroundColor White
    ArrowColor Black
    BorderColor Black
}

' Classes principales
class Visiteur {
    + id: int
}

class Membre {
    + id: int
    + nom: string
    + prenom: string
    + email: string
    + mot_de_passe: string
    + date_inscription: date
    + date_derniere_connexion: date
    + statut: enum
}

class Collaborateur {
    + id: int
    + nom: string
    + prenom: string
    + email: string
    + mot_de_passe: string
    + photo_profil: string
    + description: text
    + ordre_affichage: int
    + date_creation: date
    + date_derniere_connexion: date
    + statut: enum
}

class Administrateur {
    + id: int
    + nom: string
    + prenom: string
    + email: string
    + mot_de_passe: string
    + photo_profil: string
    + description: text
    + ordre_affichage: int
    + date_creation: date
    + date_derniere_connexion: date
    + statut: enum
}

class Evenement {
    + id: int
    + titre: string
    + description: text
    + date: date
    + heure_debut: time
    + heure_fin: time
    + lieu: string
    + type: enum
    + statut: enum
    + visibilite: enum
    + est_recurrent: boolean
    + frequence_recurrence: enum
    + date_fin_recurrence: date
}

class TypeEvenement {
    + id: int
    + nom: string
    + icone: string
    + couleur: string
}

class Image {
    + id: int
    + nom_fichier: string
    + chemin: string
    + format: string
    + taille: int
    + date_upload: date
    + type: enum
}

class Inscription {
    + id: int
    + date_inscription: date
    + statut: enum
    + invites_supplementaires: int
}

class Commentaire {
    + id: int
    + contenu: text
    + date_creation: date
    + statut: enum
}

class Session {
    + id: int
    + token: string
    + date_creation: date
    + date_expiration: date
    + statut: enum
    + adresse_ip: string
    + navigateur: string
}

class Email {
    + id: int
    + destinataire: string
    + sujet: string
    + contenu: text
    + date_envoi: date
    + statut: enum
    + type: enum
    + template: string
    + variables: json
}

class PieceJointe {
    + id: int
    + nom_fichier: string
    + chemin: string
    + format: string
    + taille: int
    + date_upload: date
}

' Relations
Membre "0..*" -- "0..*" Evenement : s'inscrit à
Collaborateur "0..*" -- "0..*" Evenement : crée
Administrateur "0..*" -- "0..*" Evenement : crée
Evenement "1" -- "1" TypeEvenement : est de type
Evenement "0..*" -- "0..*" Image : contient
Evenement "0..*" -- "0..*" Inscription : a
Membre "0..*" -- "0..*" Inscription : fait
Evenement "0..*" -- "0..*" Commentaire : a
Membre "0..*" -- "0..*" Commentaire : crée
Collaborateur "0..*" -- "0..*" Commentaire : crée
Administrateur "0..*" -- "0..*" Commentaire : crée
Collaborateur "0..*" -- "0..*" Session : a
Administrateur "0..*" -- "0..*" Session : a
Membre "0..*" -- "0..*" Email : reçoit
Collaborateur "0..*" -- "0..*" Email : reçoit
Administrateur "0..*" -- "0..*" Email : reçoit
Email "0..*" -- "0..*" PieceJointe : contient
Administrateur "0..*" -- "0..*" Collaborateur : gère
Administrateur "0..*" -- "0..*" Membre : gère
Evenement "0..*" -- "0..*" Email : est associé à

@enduml 